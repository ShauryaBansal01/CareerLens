# ── Server ───────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careerlens?retryWrites=true&w=majority

# ── Authentication ───────────────────────
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE=15m            # Access token expiry (short-lived)
REFRESH_TOKEN_EXPIRE_DAYS=7  # Refresh token expiry

# ── AI Providers ─────────────────────────
# Google Gemini (system default AI provider)
GEMINI_API_KEY=your-gemini-api-key

# ── Encryption (AES-256-GCM for BYOK) ────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Email (SMTP for OTP) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=CareerLens <noreply@careerlens.app>

# ── Redis (optional, for caching) ─────────
REDIS_URL=redis://localhost:6379

# ── Sentry (error tracking) ──────────────
SENTRY_DSN=

# ── Deployment ───────────────────────────
# Set to "true" on Render free tier to disable clustering (512MB RAM limit)
SINGLE_PROCESS=true
