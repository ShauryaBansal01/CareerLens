# ── Server ───────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careerlens?retryWrites=true&w=majority
# Connection pool (optional; defaults 10 / 2)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# ── Authentication ───────────────────────
# Required — the server refuses to start without it. Also keys the HMAC used
# to hash OTPs at rest, so changing it invalidates any outstanding codes.
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE=15m            # Access token expiry (short-lived)
REFRESH_TOKEN_EXPIRE_DAYS=7  # Refresh token expiry

# ── AI Providers ─────────────────────────
# Google Gemini (system default AI provider)
GEMINI_API_KEY=your-gemini-api-key

# Model overrides (optional — sensible defaults are built in)
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash

# Per-request timeout and total retry budget, in ms
AI_REQUEST_TIMEOUT_MS=60000
AI_RETRY_BUDGET_MS=45000

# Cost tracking: USD per 1M tokens, for models not in services/ai/pricing.js
# AI_PRICING_OVERRIDES={"gpt-4o-mini":{"input":0.15,"output":0.6}}

# ── Encryption (AES-256-GCM for BYOK) ────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Email (SMTP for OTP) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=CareerLens <noreply@careerlens.app>

# ── Sentry (error tracking) ──────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- PDF layout service (optional) ----
# Java/PDFBox service that reports column count, embedded images and page count
# for uploaded PDFs -- layout facts pdf-parse cannot see. Unset, the backend
# falls back to pdf-parse and simply omits those warnings.
# PDF_SERVICE_URL=http://localhost:8080
# PDF_SERVICE_TIMEOUT_MS=15000
# Shared secret; must match PDF_SERVICE_TOKEN on the service. Required in
# production -- unset, the service accepts requests from anyone.
# PDF_SERVICE_TOKEN=
